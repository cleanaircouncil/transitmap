---
import Nav from "./nav.astro";
import Header from "./header.astro";

import Map from "./map.astro";
import ResponsiveSheet from "./responsive-sheet.astro";

const { venue } = Astro.props

---

<main id="app" class="app layout-app" data-app>
  <section class="in-header">
    <Header>
      <slot name="header"/>
    </Header>

  </section>



  <ResponsiveSheet class="in-list">
    <div class="scroller">
      <slot/>
    </div>
  </ResponsiveSheet>

  
  <section class="in-main">
    <Map venue={ venue }/>
  </section>

  <section class="in-nav">
    <slot name="nav"/>
  </section>
</main>

<style>
  .app {
    position: absolute;
    inset: 0px;
    padding: 0px;

    font-family: var(--font-default);
    /* background: var(--color-white); */
    color: var(--color-black);
    overflow: hidden;
    padding: .25rem;
  }

  .layout-app {
    display: grid;
    gap: .25rem;
  }

  .in-list {
    position: relative;
    z-index: 10;
    
    overflow: hidden;
    border-radius: 1.25rem;
    box-shadow: 0px 5px 8px rgba(0,0,0,.3); 
    
  }

  .scroller {
    overflow: auto;
    padding-bottom: 10vh;
    height: 100%;
  }

  .in-main {
    /* grid-area: main; */
    position: absolute;
    inset: 0px;
  }

  .in-header {
    grid-area: header;
    z-index: 10;
    border-radius: 1.25rem;
    overflow: hidden ;
    box-shadow: 0px 5px 8px rgba(0,0,0,.3); 
  }

  @media screen and (max-width: 600px) {
    .layout-app {
      grid-template-rows: min-content 1fr min-content;
      grid-template-areas:
        "header"
        "main"
        "nav";
    }

    .in-list {
      pointer-events: none;
      grid-area: main;
      z-index: 20;
      /* display: none; */
    }

    .in-nav {
      grid-area: nav;
      z-index: 50;
    }
  }

  @media screen and (min-width: 600px) {
    .layout-app {
      grid-template-columns: min(45vw, 450px) 1fr;
      grid-template-rows: min-content min-content 1fr;
      grid-template-areas:
        "header main"
        "nav main"
        "list main";
    }

    .in-list {
      grid-area: list;
    }

    .in-nav {
      grid-area: nav;
    }
  }


</style>

<style is:global>
  .header-nav {
    position: absolute;
    z-index: 20;
    display: flex;
    left: 1rem;
    right: 1rem;
    justify-content: space-between;
  }
</style>



<script>
  const stickyEls = document.querySelectorAll("[data-sticky]");

  const stickyObserver = new IntersectionObserver(
    ([e]) => {
      const value = !e.isIntersecting ? "stuck" : ""
      e.target.dataset.sticky = value;
    },{
      rootMargin: "-1px 0px 0px 0px",
      threshold: [1],
    }
  )

  stickyEls.forEach(stickyEl => {
    stickyObserver.observe(stickyEl);
  })


  
  document.addEventListener('astro:page-load', () => {
    const stickyEls = document.querySelectorAll("[data-sticky]");
      stickyEls.forEach(stickyEl => {
      stickyObserver.observe(stickyEl);
    })
  });


</script>