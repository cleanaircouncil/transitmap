---


---

<div
  class="floating-chip"
  data-floating-chip
>

  <span class="floating-chip__close badge" data-close-chip><i class="fa fa-close"></i></span>
</div>


<style is:global>
 
  .floating-chip {
    display: flex;
    flex-wrap: wrap;
    min-width: 100px;
    max-width: 200px;
    justify-content: center;
    gap: 3px;
    padding: 3px;
    background: var(--color-white);
    border-radius: 1rem;
    z-index: 20;
    box-shadow: var(--box-shadow);
    display: none;
  }

  .badge {
    display: block;
    font-size: 1rem;
    font-weight: bold;
    line-height: 1;
    place-content: center;
    text-align: center;
    background: var(--color-red);
    color: var(--color-white);
    border-radius: 50%;
    aspect-ratio: 1;
    width: 1.5rem;
    top: 0%;
    right: 0%;
    translate: 25% -25%;
    position: absolute;
  }
</style>

<script>

  document.addEventListener("click", (e) => {

    const openChipEl = e.target.closest("[data-open-chip]");
    const closeChipEl = e.target.closest("[data-close-chip]");
    const stopChipEl = e.target.closest("[data-stop-chip]")

    

    if( !openChipEl && !closeChipEl ) {
      const currentlyOpenChipEl = document.querySelector("[data-stop-chip='open']");
      if( currentlyOpenChipEl && currentlyOpenChipEl !== stopChipEl ) {
        currentlyOpenChipEl.setAttribute("data-stop-chip", "");
      }

      return;
    }

    if( openChipEl ) {
      document.querySelectorAll("[data-stop-chip='open']").forEach( stopChipEl => stopChipEl.setAttribute("data-stop-chip", "") );
      stopChipEl.setAttribute("data-stop-chip", "open");
    }

    if( closeChipEl ) {
      stopChipEl.setAttribute("data-stop-chip", "");
    }


  })

</script>