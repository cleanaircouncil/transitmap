---
import BikeshareChip from "./bikeshare-chip.astro";
import Button from "./button.astro";
import StopChip from "./stop-chip.astro";
import TransitChip from "./transit-chip.astro";

const { venue } = Astro.props;
---

<Fragment>
  <figure id="map" class="map" data-map data-venue={ venue } transition:persist="map"></figure>

  <!-- <Button class="map-view-all-button box-shadow" data-map-view-all aria-label="View All Facilities">
    <i class="fa fa-expand"></i><span class="map-view-all-text">&nbsp;View All</span>
  </Button> -->

  <TransitChip/>
  <StopChip/>
  <BikeshareChip/>

  <template id="map-stop-group-stub">
    <div class="map-stop-group" data-transit-chip>

    </div>
  </template>


  <template id="map-marker-stub">
    <TransitChip/>
  </template>

  <template id="map-bikeshare-stub">
    <BikeshareChip/>
  </template>


  <template id="map-stop-stub">
    <StopChip/>
  </template>

  <template id="map-venue-stub">
    <div
      class="map-venue map-marker"
      data-venue-marker
      data-venue=""
      data-populate="slug: @data-venue"
    >
      <a class="stretched-link" data-populate="href: @href" aria-label="View venue"></a>
      <span class="map-marker__label" data-populate="name"></span>
    </div>
  </template>


</Fragment>

<style is:global>
  .map {
    width: 100%;
    height: 100%;
    pointer-events: all;
    background-color: #f2f2f2;
    position: relative;
    z-index: 0;
  }

  .map-view-all-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .map-view-all-text {
    display: none;
  }

  .map-view-all-button:hover .map-view-all-text {
    display: block;
  }

  .map-venue {
    width: 36px;
    height: 36px;
    color: var(--theme-accent);
    font-family: var(--font-default);
    font-weight: 900;
    text-align: center;
    background-size: contain;
    cursor: pointer;
    /* z-index: 100; */
    

    &::after {
      content: '\f192'; /*'\f041';*/
      color: var(--color-black);
      display: block;
      font: var(--fa-font-solid);
      width: 100%;
      height: 100%;
      font-size: 18px;
      text-shadow: 0px 3px 3px rgba(0,0,0,.25);
      margin-top: -12px;
    }
  }

  .map-venue[data-current], .map-venue[data-tour-selected] {
    z-index: 10;
    &::after {
      content: "\f041";
      color: var(--color-red);
      font-size: 36px;
      
    }
  }

  .map:has([data-tour-selected]) .map-venue:not([data-tour-selected]),
  .map:has([data-current]) .map-venue:not([data-current])
  {
    &::after {
      content: "\f192";
      font-size: 18px;
      color: var(--color-black);
      z-index: 0;
    }
  }

  .map-marker__label {
    font-family: var(--font-default);
    line-height: 1;
    font-weight: 900;
    display: none;
    position: absolute;
    width: max-content;
    max-width: 200px;
    text-wrap: pretty;
    text-align: center;
    

    left: 50%;
    top: -1rem;
    translate: -50% -100%;
    padding: 0.5rem;
    background: linear-gradient( var(--color-black),black);
    border-bottom: 3px solid var(--color-red);
    
    
    color: var(--color-white);
    box-shadow: var(--box-shadow);
    border-radius: 0.25rem;
    z-index: 10;

    font-size: 1rem;
  }

  .map-marker__label::after {
    content: "";
    display: block;
    position: absolute;
    width: 13px;
    height: 13px;
    rotate: 45deg;
    translate: -50% calc( 50% + 2px );
    background: black;
    border-bottom: 3px solid var(--color-red);
    border-right: 3px solid var(--color-red);

    left: 50%;
    bottom: 0px;
  }

  .map-marker:hover .map-marker__label {
    display: block;
  }

  .map-marker[data-current] .map-marker__label {
    display: block;
    z-index: 100;
  }

  .map-marker[data-tour-selected] .map-marker__label {
    display: block;
  }

  .map-marker[data-alert] .map-marker__label {
    background: var(--color-danger);
    color: var(--color-white);
  }

  .map-marker[data-alert] .map-marker__label::after {
    background: var(--color-danger);
  }

  @media screen and (min-width: 900px) {
    .map::after {
      content: "";
      display: block;
      position: absolute;
      top: 0px;
      left: 0px;
      bottom: 0px;
      width: 1rem;
      background: linear-gradient(90deg, var(--color-black), transparent);
      opacity: 0.1;
    }
  }
</style>

<script>
  // ─── Imports ─────────────────────────────────────────────────────────────────
  import { data, currentListingSlug, fetchVenueData, currentRoute, currentVenue, currentTour, getTourBySlug, selectVenue } from "../helpers/store";
  import { cloneTemplate, populateWithData } from "../helpers/populate";
  import { decodeRoutePolyline } from "../helpers/maps";
  import { circle, clone } from "@turf/turf";
  import Supercluster from "supercluster";

  // ─── Constants ───────────────────────────────────────────────────────────────
  const PHILLY_LAT = 39.952583;
  const PHILLY_LON = -75.165222;
  const PHILLY_CENTER = [PHILLY_LON, PHILLY_LAT];

  // import listingData from "../data/listing-stops.json";

  const maplibregl = window["maplibregl"];

  // ─── Helpers ─────────────────────────────────────────────────────────────────
  function getMapPadding() {
    // `.in-main` (this map) is a full-bleed overlay behind `.in-header`,
    // `.in-list`, and `.in-nav` — it's no longer confined to the grid's
    // "main" area, so padding has to be measured from where that chrome
    // actually sits on screen rather than assumed from the old layout.
    const mapEl = document.querySelector("[data-map]");
    const mapRect = mapEl.getBoundingClientRect();
    const margin = 20;

    const rectOf = (selector) => document.querySelector(selector)?.getBoundingClientRect();

    const headerRect = rectOf("[data-app] .in-header");
    const navRect = rectOf("[data-app] .in-nav");

    if (window.innerWidth >= 600) {
      // header, list, and nav are stacked in the left column
      const listRect = rectOf("[data-app] .in-list");
      const left = Math.max(headerRect?.right ?? 0, navRect?.right ?? 0, listRect?.right ?? 0) - mapRect.left;

      return {
        top: margin,
        right: margin,
        bottom: margin,
        left: Math.max(left, 0) + margin,
      };
    }

    // header sits over the top edge; the list sheet + nav bar sit over the bottom
    const sheetRect = rectOf("[data-sheet]");
    const top = (headerRect?.bottom ?? mapRect.top) - mapRect.top;
    const chromeTop = Math.min(sheetRect?.top ?? mapRect.bottom, navRect?.top ?? mapRect.bottom);
    const bottom = mapRect.bottom - chromeTop;

    return {
      top: Math.max(top, 0) + margin,
      bottom: Math.max(bottom, 0) + margin,
      left: margin,
      right: margin,
    };
  }

  function getTourBounds(tour, marginKm = 2) {
    const coords = tour.venues
      .map(venue => data.venues.find(v => v.slug === venue.slug)?.coordinates)
      .filter(Boolean);


    const bounds = coords.reduce(
      (bounds, [lon, lat]) => bounds.extend([lon, lat]),
      new maplibregl.LngLatBounds(coords[0], coords[0])
    );

    const center = bounds.getCenter();
    const latPad = marginKm / 111;
    const lngPad = marginKm / (111 * Math.cos(center.lat * Math.PI / 180));

    bounds.extend([bounds.getWest() - lngPad, bounds.getSouth() - latPad]);
    bounds.extend([bounds.getEast() + lngPad, bounds.getNorth() + latPad]);

    return bounds;

  }

  function getMapZoom() {
    if (window.innerWidth >= 600) return 15;
    else return 13;
  }

  function showRadius( map, center ) {
    const radius = .5; // kilometer
    const options = {
        steps: 64,
        units: 'miles'
    };
    const circleData = circle(center, radius, options);

    map.getSource('location-radius').setData(circleData);
  }

  function setCurrentMarker(slug) {
    const markers = document.querySelectorAll("[data-venue-marker]");
    markers.forEach((marker) => {
      marker.toggleAttribute(
        "data-current",
        marker.matches(`[data-venue="${slug}"]`)
      );
    });
  }

  // ─── Initialization ───────────────────────────────────────────────────────────
  async function initMap() {
    const map = new maplibregl.Map({
      container: "map", // container id
      style:
        "https://api.maptiler.com/maps/019e92f0-bef2-77ae-9e7e-3033c15fbb6a/style.json?key=v64Bpd9Og2E4Zm916XUB", // style URL
      center: PHILLY_CENTER,
      attributionControl: false,
    });

    map.setMaxPitch(0);
    map.setMinPitch(0);
    map.touchPitch.disable();
    map.dragRotate.disable();
    map.touchZoomRotate.disableRotation();

    map.fitBounds(data.meta.bounds, { padding: getMapPadding(), duration: 0 });

    return new Promise((res) => {
      map.on("load", async () => {
        res(map);
      });
    });
  }

  async function initVenues(map, data) {
    data.venues.forEach((venue) => {
      const markerEl = cloneTemplate("map-venue-stub");
      venue.href = `/venues/${venue.slug}`;
      populateWithData(markerEl, venue)


      // add marker to map
      new maplibregl.Marker({ element: markerEl })
        .setLngLat(venue.coordinates)
        .addTo(map);

    });
  }

  async function initCircle(map) {
    // Add the circle as a GeoJSON source
    map.addSource('location-radius', {
        type: 'geojson',
        data: {}
    });

    // Add a fill layer with some transparency
    map.addLayer({
        id: 'location-radius',
        type: 'fill',
        source: 'location-radius',
        paint: {
            'fill-color': '#789ebf',
            'fill-opacity': 0.1
        }
    });

    map.addLayer({
        id: 'location-radius-outline',
        type: 'line',
        source: 'location-radius',
        paint: {
            'line-color': '#789ebf',
            'line-width': 1,
            'line-dasharray': [3, 3]
        }
    });

    // showRadius(map, PHILLY_CENTER);
  }

  // ─── Venue Focus ─────────────────────────────────────────────────────────────
  function focusOnVenue( venue, slug ) {
    // return;
    if(!venue) return;

    document.querySelectorAll("[data-map] [data-chip]").forEach( chip => chip.remove() );

    const getVenueRoute = ( stopRoute ) => venue.routes[ stopRoute.route_id ]

    for( const id in venue.stops )
    {
      // break;

      const stop = venue.stops[id];
      let stopEl;
      

      if( stop.routes.length > 1 ) {
        stopEl = cloneTemplate("map-stop-stub");
        
        const venueRoute = getVenueRoute(stop.routes[0]);
        
        populateWithData(stopEl, {
          ...stop,
          route_color: venueRoute.route_color,
          route_text_color: venueRoute.route_text_color
        });

        const routeContainerEl = stopEl.querySelector("[data-routes]");

        for( const route of stop.routes ) {
          const routeEl = cloneTemplate("map-marker-stub");  
          populateWithData(routeEl, getVenueRoute( route ));
          routeContainerEl.appendChild( routeEl );
        }

        

      } else if ( stop.mode === "Bike" ) {
        stopEl = cloneTemplate("map-bikeshare-stub");
        
        populateWithData(stopEl, {
          id: stop.stop_id, 
          ...getVenueRoute( stop.routes[0] )
        });

      } else {
        stopEl = cloneTemplate("map-marker-stub");
        populateWithData(stopEl, getVenueRoute( stop.routes[0] ));
      }

      new maplibregl.Marker({ element: stopEl }) 
        .setLngLat(stop.coordinates)
        .addTo(map);
    
    }

    showRadius(map, venue.coordinates);

    setCurrentMarker(slug);
    currentRoute.set("");

    map.flyTo({
      center: venue.coordinates,
      zoom: getMapZoom(),
      padding: getMapPadding()
    })
  }

  function unfocusVenues() {
    currentRoute.set("");
    currentVenue.set("");
    document.querySelectorAll("[data-map] [data-chip]").forEach( chip => chip.remove() );
    map.getSource('location-radius').setData({});
  }

  // ─── Bootstrap ───────────────────────────────────────────────────────────────
  const map = await initMap();

  await initVenues(map, data);
  await initCircle(map);

  map.addSource('route-display', {
      type: 'geojson',
      data: {}
  });

  map.addLayer({
      id: 'route-display',
      type: 'line',
      source: 'route-display',
      paint: {
          'line-width': 10,
          'line-color-transition': { duration: 0, delay: 0},
          'line-width-transition': { duration: 0, delay: 0},
      }
  });

  const mapEl = document.querySelector("[data-map]");
  
  if( mapEl.dataset.venue ) {
    const venue = await fetchVenueData( mapEl.dataset.venue );
    focusOnVenue(venue, mapEl.dataset.venue);
  }



  // map.on("movsdfsdfseend", () => {
    

  //   (async () => {

  //     const venue_id = currentVenue.get();
      
  //     if(!venue_id) 
  //       return;

  //     const venue = await fetchVenueData(venue_id);


  //     const stopToPoint = ([key, stop]) => ({
  //       type: "Feature",
  //       geometry: { type: "Point", coordinates: stop.coordinates },
  //       properties: {
  //         stop_key: key,
  //         stop_name: stop.stop_name,
  //         mode: stop.mode,
  //         route_count: stop.routes.length,
  //         routes: stop.routes
  //       }
  //     })

  //     const points = Object.entries(venue.stops)
  //       .filter(([key, stop]) =>  stop.mode != "Bike" )
  //       .map( stopToPoint );

  //     const bikePoints = Object.entries(venue.stops)
  //       .filter(([key, stop]) =>  stop.mode === "Bike" )
  //       .map( stopToPoint );

  //     const bounds = map.getBounds();
  //     const bbox = [bounds.getWest(), bounds.getSouth(), bounds.getEast(), bounds.getNorth()];
  //     const zoom = Math.floor(map.getZoom());
  //     const index = new Supercluster({ 
  //       radius: 20, 
  //       maxZoom: 16,
  //       map: (props) => ({ routes: props.routes }),
  //       reduce: (acc, props) => {
  //         const unique = props.routes.filter( route => !acc.routes.some( r => r.route_id === route.route_id ))
  //         acc.routes.push( ...unique )
  //       }
  //     }).load(points)

  //     const clusters = [...index.getClusters(bbox, zoom), ...bikePoints]
      

  //     document.querySelectorAll("[data-map] [data-chip]").forEach( chip => chip.remove() );


  //     const getVenueRoute = ( stopRoute ) => venue.routes[ stopRoute.route_id ]

  //     for( const cluster of clusters ) {
  //       let stopEl;
  //       const stop = cluster.properties;

  //       if( stop.cluster ) {
  //         stopEl = cloneTemplate("map-stop-stub");
  //         populateWithData(stopEl, stop);

          
  //         // console.log( cluster );


  //         const routeContainerEl = stopEl.querySelector("[data-routes]");

  //         for( const route of stop.routes ) {
  //           const routeEl = cloneTemplate("map-marker-stub");  
  //           populateWithData(routeEl, getVenueRoute( route ));
  //           routeContainerEl.appendChild( routeEl );
  //         }


  //       } else {
  //         console.log( cluster );
  //         stopEl = cloneTemplate("map-marker-stub");
  //         populateWithData(stopEl, getVenueRoute( stop.routes[0] ));
  //       }

  //       new maplibregl.Marker({ element: stopEl }) 
  //         .setLngLat(cluster.geometry.coordinates)
  //         .addTo(map);
  //     }

  //     // showRadius(map, venue.coordinates);

  //     // setCurrentMarker(venue);
  //     // currentRoute.set("");

  //     // map.flyTo({
  //     //   center: venue.coordinates,
  //     //   zoom: getMapZoom(),
  //     //   padding: getMapPadding()
  //     // })

  //   })()
  // })



  // ─── Subscriptions & Events ───────────────────────────────────────────────────
  currentRoute.subscribe( (route_id) => {
    (async() => {
      if(!route_id) {
        map.getSource("route-display").setData({ type: "FeatureCollection", features: [] });
        return;
      }

      const venue = await fetchVenueData( currentVenue.get() );
      const route = venue.routes[route_id];

      // console.log( currentVenue )
      const features = decodeRoutePolyline( route.polylines );
      const routeColor = (route.route_color && route.route_color !== "#FFFFFF") ? route.route_color : "#000"

      map.setPaintProperty("route-display", "line-width", route.namespace == "indego" ? 5 : 8);
      map.setPaintProperty("route-display", "line-color", routeColor );
      map.getSource("route-display").setData( features );
    })()
  })

  currentVenue.subscribe( (venue_id) => {
    // console.log( "current venue", venue_id );
    document.querySelectorAll("[data-venue-marker]").forEach( venueEl => {
      venueEl.toggleAttribute("data-current", venueEl.dataset.venue == venue_id )
      venueEl.removeAttribute("data-tour-selected");
    })
    if (venue_id) {
      (async () => {
        const venue = await fetchVenueData(venue_id);
        focusOnVenue(venue, venue_id);
      })();
    }
  })





  currentTour.subscribe( (tour_id) => {
    // console.log( "current tour", tour_id );
    const tour = getTourBySlug( tour_id );

    document.querySelectorAll("[data-venue-marker]").forEach( venueEl => {
      venueEl.toggleAttribute("data-tour-selected", !!tour && tour.venues.some( venue => venue.slug == venueEl.dataset.venue ) )
      venueEl.removeAttribute("data-current");
    })

    if( !tour ) return;

    const tourBounds = getTourBounds(tour);
    map.fitBounds(tourBounds, { padding: getMapPadding(), duration: 1000 });

    unfocusVenues();
  })
  

  function handleVenueMarkerClick(e) {
    const venueMarkerEl = e.target.closest("[data-venue-marker]");
    if (!venueMarkerEl) return;
    selectVenue(venueMarkerEl.dataset.venue);
  }

  function handleMapDismissClick(e) {
    const mapEl = e.target.closest("[data-map]");
    if (!mapEl) return;
    
    const chipEl = e.target.closest("[data-chip]");
    if(chipEl) return;
    
    currentRoute.set("");
  }

  document.addEventListener("click", (e) => {
    handleVenueMarkerClick(e);
    handleMapDismissClick(e);
  })

</script>
