---
import Button from "./button.astro";
const { current = "events" } = Astro.props;

function isCurrent(path) {
  return path == current ? "page" : false;
}

const hasChildren = Astro.slots.has("default");
---

<nav id="nav" class="nav">

  <slot/>

  { !hasChildren &&

    <Button class="button--nav" href="/" aria-current={isCurrent("/")}>
      <i class="fa fa-calendar"></i> Events
    </Button>

    <Button class="button--nav" href="/tours" aria-current={isCurrent("/tours")}>
      <i class="fa fa-compass"></i> Tours
    </Button>

    <Button class="button--nav" href="/about" aria-current={isCurrent("/about")}>
      <i class="fa fa-question-circle"></i> About
    </Button>

  }

</nav>

<style>
  .nav {
    color: var(--color-white);
    height: 100%;
    display: flex;
    background: linear-gradient( 135deg, var(--color-black), black );
    border-radius: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem; 
    position: relative;
    box-shadow: inset 0px 3px 0px rgba(0,0,0,.1), 0px 5px 8px rgba(0,0,0,.3); 
  }

</style>