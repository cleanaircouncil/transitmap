---
import ExpandableChip from "./expandable-chip.astro";

const { stop = {} } = Astro.props;

---

<ExpandableChip
class="stop-chip"
  data-stop-chip
  data-auto-expand
  data-populate="mode: @data-mode, id: @data-stop-chip, route_color: --route-color, route_text_color: --route-text-color"
  data-mode={stop.mode}
>

  <div class="stop-chip__cluster" slot="collapsed">
    <div class="stop-chip__icon">
      <i data-mode="Bike" class="fa fa-bicycle"></i>
      <i data-mode="Bus" class="fa fa-bus-simple"></i>
      <i data-mode="Rail" class="fa fa-train"></i>
      <i data-mode="Metro" class="fa fa-train-subway"></i>
    </div>

    <span class="stop-chip__count badge badge--blue" data-populate="routes.length" ></span>
  </div>

  <div class="stack-tight" slot="expanded">
    <div class="stop-chip__name" data-populate="stop_name">Name</div>
    <div class="stop-chip__routes" slot="expanded" data-routes></div>
  </div>
  

</ExpandableChip>



<style is:global>
 

  .stop-chip__cluster {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    box-shadow: 0px 5px 5px rgba(0,0,0,.10);
    background: var(--route-color, var(--color-black));
    color: var(--route-text-color, var(--color-white));

    display: grid;
    cursor: pointer;

   

    .stop-chip__icon {
      font-size: 1.5rem;
      border: .15rem solid var(--route-text-color, var(--color-white));
      color: var(--route-text-color, var(--color-white));
      aspect-ratio: 1;
      place-content: center;
      text-align: center;
      width: calc( 100% - 4px );
      height: calc( 100% - 4px );
      border-radius: 50%;
      margin: 2px;
    }



  }

  .stop-chip__name {
    font-weight: 900;
  }


  .stop-chip__icon [data-mode] {
    display: none;
  }

  [data-mode="Bus"] .stop-chip__icon [data-mode="Bus"] {
    display: block;
  }

  [data-mode="Metro"] .stop-chip__icon [data-mode="Metro"] {
    display: block;
  }

  [data-mode="Bike"] .stop-chip__icon [data-mode="Bike"] {
    display: block;
  }

  [data-mode="Rail"] .stop-chip__icon [data-mode="Rail"] {
    display: block;
  }
  

  .stop-chip__routes {
    display: flex;
    flex-wrap: wrap;
    min-width: 100px;
    max-width: 200px;
    justify-content: start;
    gap: 3px;
  }

  .badge {
    display: block;
    font-size: 1rem;
    font-weight: bold;
    line-height: 1;
    place-content: center;
    text-align: center;
    background: var(--color-red);
    color: var(--color-white);
    border-radius: 50%;
    aspect-ratio: 1;
    width: 1.5rem;
    top: 0%;
    right: 0%;
    translate: 25% -25%;
    position: absolute;
  }

  .badge--blue {
    background: var(--color-white); 
    color: var(--color-black);
  }


  body:has([data-transit-chip="selected"]) {
    [data-stop-chip]:not([data-expandable-chip="open"], :has([data-transit-chip="selected"])) {
      filter: var(--filter-dimmed);
    }
  }


</style>
