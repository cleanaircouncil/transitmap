---
import ReplaceFlags from "./replace-flags.astro";

const { tour } = Astro.props;

const date = (tour.date !== undefined) ? new Date(tour.date) : new Date();
const time = Intl.DateTimeFormat("en-US", {hour: "numeric"}).format(date);
---

<div class="tour_info stack-tight">

  <div class="tour__name">
    <ReplaceFlags title={ tour.name }/>
  </div>

  <div class="tour__description">
    { tour.description }
  </div>

  <div class="tour__meta">
    { tour.venues.length } stops
  </div>

</div>


<style>

  .tour__explore {
    text-align: center;
    
    display: block;
    font-size: 1rem;
    font-style: italic;
  }

  .tour__details {
    color: var(--color-black);
    text-decoration: none;
  }
  
  .tour__group {
    color: var(--color-green-500);
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
  }

  .tour__meta {
    color: var(--color-neutral-500);
    font-weight: 700;
    /* text-transform: uppercase; */
    font-size: 1.1rem;

    a {
      color: var(--color-neutral-500);
      text-decoration: none;
    }
  }

  .tour__name {
    font-weight: 500;
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1;
  }

  .tour__time {
    color: var(--color-black);
  }


  </style>