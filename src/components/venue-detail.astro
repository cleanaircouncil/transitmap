---
import data from "../data/index.json";
import ListingList from "./listing-list.astro";

const { venue = {} } = Astro.props

const listings = data.listings.filter( listing => listing.venue_id == venue.slug );
const tours = data.tours.filter( tour => tour.venues.some( v => v.slug == venue.slug ) );

---

<div class="venue" data-venue={ venue.slug }>
  <div class="venue__info constrain stack">
    <h2 class="venue__name">{venue.name}</h2>
    <div class="venue__address"><i class="fa fa-location-dot"></i> {venue.address}</div>


    {
      tours.length ?
      <div class="venue__tours">
        <div><i class="fa fa-compass"></i> <em>This venue is a part of { tours.length } tour{ tours.length == 1 ? "" : "s"}:</em></div>
        <ul>
          { tours.map( tour => <li><a href={`/tours/${tour.slug}`}>{tour.name}</a></li>)}
        </ul>
      </div> 

      : <></>
    }

  </div>

  <ListingList listings={ listings }/>
</div>

<style>

  .venue__name {
    font-weight: 700;
    font-style: italic;
    font-size: 2rem;
    line-height: 1.2;
    text-wrap: balanced;
  }

  .venue__info {
    background: linear-gradient( var(--color-white), var(--color-neutral-150) );
    padding-bottom: 2rem;
  }


  .venue__listings-title {
    font-size: 1.5rem;
    font-weight: 300;
    font-style: italic;
    
  }

  .venue__tours {
    background: var(--color-green-100);
    border: 1px solid var(--color-green-200);
    padding: 1rem;
    border-radius: 1rem;
    line-height: 1.8;
    font-size: 1rem;

    a {
      color: var(--color-green-400)
    }

    i {
      color: var(--color-green-700);
    }
  }


</style>


