---
import type { GetStaticPaths } from "astro";
import data from "../../data/index.json";
import ListingDetail from "../../components/listing-detail.astro"
import AppLayout from "../../layouts/app-layout.astro";
import Button from "../../components/button.astro";
import DirectionsButton from "../../components/directions-button.astro";
import Nav from "../../components/nav.astro";

export const getStaticPaths = (() => {
  return data.listings.map((listing) => ({
    params: {
      slug: listing.slug,
    },
    props: {
      listing,
    },
  }));
}) satisfies GetStaticPaths;

const { listing } = Astro.props;

const venue = data.venues.find( venue => venue.slug == listing.venue_id );
---

<AppLayout venue={listing.venue_id}>
  <Nav slot="nav" current={ Astro.url.pathname }>
    <Button class="button--nav" href="/" ><i class="fa fa-arrow-left"></i> Events</Button>
    <DirectionsButton venue={venue} />
  </Nav>

  <div class="stack">
    <ListingDetail listing={listing} />
  </div>
</AppLayout>

<style>
  .push {
    margin-top: 2rem;
  }
</style>


<script is:inline define:vars={{ venueSlug: listing.venue_id }}>
  window.__pendingVenue = venueSlug;
</script>

<script>
  import { selectVenue } from "../../helpers/store";
  document.addEventListener('astro:page-load', () => {
    const w = window as any;
    if (w.__pendingVenue) {
      selectVenue(w.__pendingVenue);
      w.__pendingVenue = null;
    }
  });
</script>