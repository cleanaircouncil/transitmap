---
import TourList from "../components/tour-list.astro";
import AppLayout from "../layouts/app-layout.astro";
import Nav from "../components/nav.astro";

import data from "../data/index.json";

---

<AppLayout>
  <div class="intro">
    Curated routes to explore the city. Pick a theme and leave the car behind.
  </div>
  <TourList tours={ data.tours }/>
  <Nav current={ Astro.url.pathname } slot="nav"/>
</AppLayout>


<style>
  .intro {
    font-size: 1.4rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--color-neutral-150);
    background: linear-gradient(150deg, var(--color-white), var(--color-neutral-150));
  }
</style>